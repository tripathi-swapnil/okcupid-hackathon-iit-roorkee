aborn as sns\n\n# Load data\ndf = pd.read_csv(\"/kaggle/input/okcupid/profiles.csv\")\n\n# Preview relevant columns\ndf_pets = df[['sex', 'orientation', 'pets', 'location']].copy()\n\n# Drop rows with null pet preferences\ndf_pets.dropna(subset=['pets'], inplace=True)\n\n# Normalize pet preference categories\ndef classify_pet_preference(pet_str):\n    pet_str = pet_str.lower()\n    if \"likes dogs and likes cats\" in pet_str:\n        return \"Likes both\"\n    elif \"likes dogs\" in pet_str:\n        return \"Likes dogs\"\n    elif \"likes cats\" in pet_str:\n        return \"Likes cats\"\n    elif \"has dogs\" in pet_str and \"has cats\" in pet_str:\n        return \"Has both\"\n    elif \"has dogs\" in pet_str:\n        return \"Has dogs\"\n    elif \"has cats\" in pet_str:\n        return \"Has cats\"\n    else:\n        return \"Other\"\n\ndf_pets['pet_preference'] = df_pets['pets'].apply(classify_pet_preference)\n\n# Pet preference by gender\nplt.figure(figsize=(10,6))\nsns.countplot(data=df_pets, x='pet_preference', hue='sex', order=df_pets['pet_preference'].value_counts().index)\nplt.title(\"Pet Preferences by Gender\")\nplt.xticks(rotation=45)\nplt.ylabel(\"Count\")\nplt.xlabel(\"Pet Preference\")\nplt.tight_layout()\nplt.show()\n\n# Pet preference by orientation\nplt.figure(figsize=(10,6))\nsns.countplot(data=df_pets, x='pet_preference', hue='orientation', order=df_pets['pet_preference'].value_counts().index)\nplt.title(\"Pet Preferences by Sexual Orientation\")\nplt.xticks(rotation=45)\nplt.ylabel(\"Count\")\nplt.xlabel(\"Pet Preference\")\nplt.tight_layout()\nplt.show()\n\n# Compatibility Matrix (same pet preference pair count)\ncompatibility_df = df_pets[['sex', 'orientation', 'pet_preference']]\npet_match_counts = compatibility_df.groupby('pet_preference').size().reset_index(name='count')\nprint(\"Pet Preference Distribution:\\n\", pet_match_counts)\n\n# Optional: heatmap of pet preference cross-tab\ncross_tab = pd.crosstab(df_pets['sex'], df_pets['pet